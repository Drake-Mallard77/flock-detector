# Copy to terraform.tfvars (gitignored) and fill in. Never commit the real
# file — it will contain secrets.
#
# Values below matching this project's actual tenancy (region ca-toronto-1,
# root compartment) are real and current as of when this was written — the
# image OCID in particular is versioned and Canonical publishes new ones
# periodically, so re-check it with:
#   oci compute image list --compartment-id <tenancy_ocid> \
#     --operating-system "Canonical Ubuntu" --shape "VM.Standard.A1.Flex" \
#     --region ca-toronto-1

tenancy_ocid     = "ocid1.tenancy.oc1..aaaaaaaanaqe2in3xjszh2zmpzlqwmf3q5a2m3gb5prvu6ojtgme66btocfq"
compartment_ocid = "ocid1.tenancy.oc1..aaaaaaaanaqe2in3xjszh2zmpzlqwmf3q5a2m3gb5prvu6ojtgme66btocfq" # root compartment
region           = "ca-toronto-1"
image_ocid       = "ocid1.image.oc1.ca-toronto-1.aaaaaaaa2o5hlxuly5jlhqzpnwx47e3u4fpy5wejass7tci5ik5ahnp47nga" # Canonical-Ubuntu-24.04-aarch64-2026.07.17-0

ssh_public_key  = "ssh-ed25519 AAAA... you@example.com" # your own key, not a placeholder
ssh_source_cidr = "203.0.113.10/32"                       # YOUR IP (`curl ifconfig.me`), not 0.0.0.0/0

app_image = "ghcr.io/drake-mallard77/flock-detector-api:latest"

# Generate, don't invent: `openssl rand -base64 24` / `openssl rand -base64 32`
db_password = "replace-with-24-plus-random-characters"
jwt_secret  = "replace-with-32-plus-random-characters"

allowed_origin = "http://localhost:5173" # update once apps/web is deployed (Phase 4)
domain          = ""                      # set once you have one; see modules/compute Caddyfile notes
