# Cloud Run injects PORT; Caddy binds it with automatic HTTPS disabled
# because Google's front end already terminates TLS.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# Canonical host: www redirects to the apex.
	#
	# Cloud Run's domain mapping serves both from this same container, so
	# without this they answer 200 with identical content — duplicate content
	# that splits search ranking across two URLs for every page.
	#
	# Matching `www.` specifically rather than "any host that isn't
	# canonical" is deliberate. The general form has to be inert when
	# SITE_HOST is unset (local dev, the bare run.app URL), and every version
	# of that check is a redirect loop or an outage waiting for the one
	# environment where the variable is missing. Matching one known-bad
	# prefix cannot misfire: localhost and run.app hostnames never start
	# with www.
	@www header_regexp Host ^www\.
	redir @www https://{$SITE_HOST:theflockwatcher.com}{uri} permanent

	# /sitemap.xml is generated from the database by the API, because the
	# record set refreshes weekly while deploys are occasional — a file baked
	# at build time would advertise a stale snapshot. It has to be served
	# from this origin to be valid for these URLs, hence the proxy rather
	# than a link to the API host.
	handle /sitemap.xml {
		reverse_proxy {$API_ORIGIN:http://localhost:8080}
	}

	# Long-lived caching for content-hashed build assets; never for the HTML
	# shell, which would otherwise keep pointing at old asset hashes after a
	# deploy. Matching "not /assets/*" rather than "/index.html" is
	# deliberate: the shell is served for "/" and every SPA route via
	# try_files, so a literal /index.html matcher misses almost every real
	# request for it.
	# /tiles/* is excluded here and sets its own cache policy in its handler
	# below — without that exclusion the shell's no-cache would apply to
	# every map tile and defeat tile caching entirely.
	@hashed path /assets/*
	@shell not path /assets/* /tiles/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @shell Cache-Control "no-cache"

	# Baseline hardening. No CSP here yet: MapLibre needs blob: workers and
	# the CARTO tile origin, so a wrong policy would silently break the map —
	# worth adding deliberately rather than guessing.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Map tiles are proxied through this origin rather than loaded directly
	# from the CDN. Two reasons, both real:
	#
	#  1. Privacy-focused browsers and extensions (DuckDuckGo, uBlock, etc.)
	#     block third-party CDN requests, which silently left the map blank.
	#     This site's audience is disproportionately those users.
	#  2. A surveillance-transparency site shouldn't leak its visitors'
	#     browsing to a third-party CDN in the first place — first-party
	#     tiles mean the tile host never sees who is looking at what.
	#
	# The same reasoning covers the geocoder below, where it matters more: a
	# place search on this site can reveal where someone lives or is headed.

	# Nominatim (OpenStreetMap's geocoder) for the map's place search.
	#
	# Nominatim's usage policy REQUIRES an identifying User-Agent and
	# rate-limits to ~1 req/sec. The client debounces; do not remove either.
	handle_path /geocode/* {
		reverse_proxy https://nominatim.openstreetmap.org {
			header_up Host nominatim.openstreetmap.org
			header_up User-Agent "flockwatch (+https://github.com/drake-mallard77/flock-detector)"
		}
	}

	# Esri's Light Gray Canvas, reached keyless. Alternatives ruled out:
	# tile.openstreetmap.org blocks application traffic under OSM's tile
	# usage policy; CARTO watermarks "API KEY REQUIRED" over keyless tiles;
	# OpenFreeMap only serves vector tiles at street zoom, which would put
	# WebGL back in the critical path.
	handle_path /tiles/* {
		reverse_proxy https://server.arcgisonline.com {
			header_up Host server.arcgisonline.com
			# Don't forward the visitor's identifying headers upstream.
			header_up -Referer
			header_up -Cookie
			header_up -X-Forwarded-For
		}
		header Cache-Control "public, max-age=86400"
	}

	# Requests that name a file extension are served as files or 404 — they
	# never fall through to the SPA shell.
	#
	# Without this, try_files below answered *every* unmatched path with
	# index.html and a 200, including /robots.txt: crawlers asking for
	# robots.txt got an HTML document with `Content-Type: text/html` and a
	# success status, which is worse than a 404 because nothing signals that
	# the file is absent. Same for a mistyped asset — a missing script
	# returned HTML instead of failing.
	@file path_regexp \.[a-zA-Z0-9]{2,5}$
	handle @file {
		file_server
	}

	# SPA history routing: react-router owns /deployments/:id etc., so any
	# unmatched path must fall through to index.html rather than 404.
	#
	# Wrapped in `handle` so it's mutually exclusive with the tile proxy
	# above. Bare `try_files` belongs to Caddy's rewrite phase, which runs
	# *before* `handle_path` — so tile requests were being rewritten to
	# /index.html and served the HTML shell instead of an image.
	handle {
		try_files {path} /index.html
		file_server
	}
}
