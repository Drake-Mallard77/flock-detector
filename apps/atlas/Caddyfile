# Cloud Run injects PORT; Caddy binds it with automatic HTTPS disabled
# because Google's front end already terminates TLS.
{
	auto_https off
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode gzip

	# Long-lived caching for content-hashed build assets; never for the HTML
	# shell, which would otherwise keep pointing at old asset hashes after a
	# deploy. Matching "not /assets/*" rather than "/index.html" is
	# deliberate: the shell is served for "/" and every SPA route via
	# try_files, so a literal /index.html matcher misses almost every real
	# request for it.
	@hashed path /assets/*
	@shell not path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header @shell Cache-Control "no-cache"

	# Baseline hardening. No CSP here yet: MapLibre needs blob: workers and
	# the CARTO tile origin, so a wrong policy would silently break the map —
	# worth adding deliberately rather than guessing.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# SPA history routing: react-router owns /deployments/:id etc., so any
	# unmatched path must fall through to index.html rather than 404.
	try_files {path} /index.html
	file_server
}
